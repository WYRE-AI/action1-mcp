# Action1 credentials for stdio and for HTTP when AUTH_MODE=env.
# Gateway mode ignores these and requires X-Action1-* headers on each request.
# Do not put them on the gateway Compose service.
ACTION1_API_KEY=
ACTION1_SECRET=
ACTION1_REGION=NorthAmerica
ACTION1_DEFAULT_ORG_ID=

# stdio (default) or http
# MCP_TRANSPORT=http

# Bind address when MCP_TRANSPORT=http. Defaults to 127.0.0.1.
# A configured CONDUIT_S2S_SECRET honors this value. The container image sets 0.0.0.0.
# When there is no secret, MCP_ALLOW_INSECURE_DEV=1 binds 127.0.0.1 only.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080
# PORT=8080

# Required to start the HTTP transport. Leave this empty here.
# The process exits if this is empty or a known placeholder (changeme,
# replace-with-a-real-secret, and similar), so a copied example cannot forge
# X-Gateway-S2S. Compose will not start when it is unset. Never commit a real value.
# Generate with: openssl rand -hex 32
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without CONDUIT_S2S_SECRET.
# Logs a warning, does not enforce X-Gateway-S2S, and binds 127.0.0.1 only.
# A non-loopback MCP_HTTP_HOST refuses to start. Do not use in production.
# A placeholder secret is still rejected when this is set.
# MCP_ALLOW_INSECURE_DEV=1

# gateway (Docker image and Compose default) or env.
# gateway requires X-Action1-API-Key and X-Action1-Secret on each request and
# never falls back to ACTION1_*. env uses those variables only after S2S auth.
# AUTH_MODE=gateway
